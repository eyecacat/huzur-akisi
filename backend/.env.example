# Bu dosyayi .env olarak kopyalayin ve kendi degerlerinizi girin.
# .env dosyasi asla GitHub'a yuklenmemelidir (bkz. .gitignore).
#
# Vercel / Render / Railway gibi platformlarda .env dosyasi kullanilmaz;
# bunun yerine platformun "Environment Variables" / "Secrets" bolumunden
# ayni degiskenler tanimlanir.

# OpenRouter API anahtariniz (https://openrouter.ai/keys adresinden alinir)
OPENROUTER_API_KEY=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

# Kullanilacak model. Ucretsiz katmanda kullanilabilecek bazi ornekler:
#   meta-llama/llama-3.1-8b-instruct:free
#   google/gemma-2-9b-it:free
#   mistralai/mistral-7b-instruct:free
# Guncel ucretsiz model listesi icin: https://openrouter.ai/models?max_price=0
LLM_MODEL=meta-llama/llama-3.1-8b-instruct:free

# OpenRouter istatistikleri icin (opsiyonel, bos birakilabilir)
SITE_URL=https://github.com/eyecacat/huzur-akisi
SITE_ADI=Huzur Akisi

# CORS: production'da frontend'inizin adresini yazin (virgulle birden fazla eklenebilir)
# Ornek: https://huzur-akisi.vercel.app
# Bos/"*" birakilirsa tum originlere izin verilir (sadece gelistirme icin uygundur)
CORS_ORIGINS=*

# IP basina dakikalik istek limiti
RATE_LIMIT_PER_MINUTE=30
