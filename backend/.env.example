# Bu dosyayi .env olarak kopyalayin ve kendi degerlerinizi girin.
# .env dosyasi asla GitHub'a yuklenmemelidir (bkz. .gitignore).

# Anthropic API anahtariniz (https://console.anthropic.com adresinden alinir)
ANTHROPIC_API_KEY=sk-ant-buraya-kendi-anahtarinizi-yazin

# Kullanilacak model (varsayilan: claude-sonnet-4-6)
LLM_MODEL=claude-sonnet-4-6
